# ==============================================================================
# DOU Fleet OS — Production & Development Environment Configuration
# ==============================================================================

# Application Environment (development / production / test)
APP_ENV=development

# Database Connection URL (PostgreSQL in production, SQLite for local dev)
# PostgreSQL: postgresql://dou_user:secure_password@localhost:5432/dou_prod
DATABASE_URL=sqlite:///./dou.db

# Cryptographic Keys (Must be >= 32 bytes in production)
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-minimum-32-bytes-long

# Admin Portal Master Key (Must be >= 16 bytes in production)
# Generate with: openssl rand -hex 16
ADMIN_KEY=change-me-in-production-admin-key-16b

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://app.doufleet.com,https://admin.doufleet.com,http://localhost:8123,http://127.0.0.1:8123

# Redis Caching (Optional but recommended for high concurrency)
REDIS_URL=redis://localhost:6379/0

# Data Residency & Storage Region (SA / EG / EU / US)
DATA_RESIDENCY_REGION=SA
DATABASE_REGION=me-central-1
STORAGE_REGION=me-central-1

# Document Storage Provider (LOCAL / S3)
STORAGE_PROVIDER=LOCAL
S3_BUCKET=dou-fleet-documents
AWS_REGION=me-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=dou-fleet-backups

# Observability & Error Tracking (Optional)
SENTRY_DSN=
GOOGLE_ANALYTICS_ID=G-XF8YF12JVQ

# Feature Flags
ENABLE_LEGACY_DELIVERY=false
ENABLE_PUBLIC_COMPANY_SIGNUP=false
SEED_DEMO_DATA=false

# DOU AI Settings (Deterministic zero-cost operational intelligence)
DOU_AI_MODE=DETERMINISTIC
NOTIFICATION_DEDUPE_MINUTES=60
