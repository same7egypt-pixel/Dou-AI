# DOU Server — environment variables
DATABASE_URL=sqlite:///./dou.db
SECRET_KEY=change-me-in-production
SMALL_ORDER_LOCAL_RADIUS_KM=5
LONG_DISTANCE_THRESHOLD_KM=25

# DOU AI uses deterministic conversational BI in production.
# No Ollama/model service or AI API configuration is required.
DOU_AI_MODE=DETERMINISTIC

# Generate a strong local secret; configure the same value in approved Metabase webhooks.
METABASE_WEBHOOK_SECRET=
NOTIFICATION_DEDUPE_MINUTES=60

# Metabase analytics integration (optional)
# Only pre-registered Saved Questions are executable.
METABASE_URL=http://localhost:3000
METABASE_API_KEY=
METABASE_DATABASE_ID=4
